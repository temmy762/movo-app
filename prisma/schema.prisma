generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  DRIVER
  ADMIN
}

enum DriverStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum WalletTxType {
  PAYOUT
  TOPUP
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SupportCategory {
  CONTACT_DRIVER
  RIDE_ISSUE
  PAYMENT_HELP
  CHAT_SUPPORT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Auth models ──────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String?   @unique
  phone       String?   @unique
  password    String
  googleId    String?   @unique
  role        Role      @default(USER)
  title       String?
  company     String?
  street      String?
  postCode    String?
  city        String?
  country     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions        Session[]
  bookings         Booking[]
  supportTickets   SupportTicket[]
}

model Driver {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  email     String       @unique
  phone     String?      @unique
  password  String
  country   String
  city      String
  status    DriverStatus @default(PENDING)
  lat       Float?
  lng       Float?
  isOnline           Boolean      @default(false)
  trainingCompleted  Int[]        @default([])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions        Session[]
  bookings         Booking[]
  vehicle          Vehicle?
  walletTxs        WalletTransaction[]
}

model Vehicle {
  id        String   @id @default(cuid())
  driverId  String   @unique
  driver    Driver   @relation(fields: [driverId], references: [id])
  make      String
  model     String
  year      Int
  plate     String
  tier      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  role      Role
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id                    String        @id @default(cuid())
  clientName            String
  pickup                String
  dropoff               String
  carTier               String
  carName               String
  fare                  Float
  serviceFee            Float
  total                 Float
  status                BookingStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(UNPAID)
  stripePaymentIntentId String?
  rating                Float?
  review                String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  supportTickets SupportTicket[]
}

// ─── Support ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String          @id @default(cuid())
  category    SupportCategory
  issue       String?
  description String?
  status      SupportStatus   @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookingId   String?
  booking     Booking?        @relation(fields: [bookingId], references: [id])

  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
}

// ─── Wallet ────────────────────────────────────────────────────────────────────

model WalletTransaction {
  id        String         @id @default(cuid())
  type      WalletTxType
  status    WalletTxStatus @default(PENDING)
  amount    Float
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  driverId  String
  driver    Driver         @relation(fields: [driverId], references: [id])
}
