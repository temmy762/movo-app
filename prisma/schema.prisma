generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  DRIVER
  ADMIN
}

enum DriverStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum WalletTxType {
  PAYOUT
  TOPUP
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SupportCategory {
  CONTACT_DRIVER
  RIDE_ISSUE
  PAYMENT_HELP
  CHAT_SUPPORT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentType {
  ACCIDENT
  UNSAFE_DRIVING
  HARASSMENT
  VEHICLE_ISSUE
  ROUTE_DEVIATION
  OTHER
}

enum ReviewStatus {
  PENDING
  AI_REVIEWED
  MANUALLY_REVIEWED
  RESOLVED
  DISMISSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OnboardingType {
  INDIVIDUAL
  FLEET
}

enum OnboardingAdminStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  DRIVERS_LICENSE
  BACKGROUND_CHECK
  DRIVERS_ABSTRACT
  VEHICLE_REGISTRATION
  VEHICLE_INSURANCE
  VEHICLE_PHOTO
  PROFILE_PHOTO
  WORK_ELIGIBILITY
  BANKING_INFO
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Auth models ──────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String?   @unique
  phone       String?   @unique
  password    String
  googleId    String?   @unique
  role        Role      @default(USER)
  title       String?
  company     String?
  street      String?
  postCode    String?
  city        String?
  country     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions        Session[]
  bookings         Booking[]
  supportTickets   SupportTicket[]
  incidentReports  IncidentReport[]
}

model Driver {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  email     String       @unique
  phone     String?      @unique
  password  String
  country   String
  city      String
  status    DriverStatus @default(PENDING)
  lat       Float?
  lng       Float?
  isOnline           Boolean            @default(false)
  trainingCompleted  Int[]              @default([])
  onboardingType     OnboardingType?    
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sessions        Session[]
  bookings         Booking[]
  vehicle          Vehicle?
  walletTxs        WalletTransaction[]
  incidentReports  IncidentReport[]
  onboarding       DriverOnboarding?
}

model Vehicle {
  id        String   @id @default(cuid())
  driverId  String   @unique
  driver    Driver   @relation(fields: [driverId], references: [id])
  make      String
  model     String
  year      Int
  plate     String
  tier      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  role      Role
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id                    String        @id @default(cuid())
  clientName            String
  pickup                String
  dropoff               String
  carTier               String
  carName               String
  fare                  Float
  serviceFee            Float
  total                 Float
  status                BookingStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(UNPAID)
  stripePaymentIntentId String?
  rating                Float?
  review                String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  supportTickets  SupportTicket[]
  tripLocations   TripLocation[]
  incidentReports IncidentReport[]
}

// ─── Trip Location (live tracking) ────────────────────────────────────────────

model TripLocation {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  lat       Float
  lng       Float
  heading   Float?
  speed     Float?
  timestamp DateTime @default(now())

  @@index([bookingId, timestamp])
}

// ─── Support ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String          @id @default(cuid())
  category    SupportCategory
  issue       String?
  description String?
  status      SupportStatus   @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookingId   String?
  booking     Booking?        @relation(fields: [bookingId], references: [id])

  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
}

// ─── Driver Onboarding ─────────────────────────────────────────────────────────

model DriverOnboarding {
  id             String                @id @default(cuid())
  type           OnboardingType        @default(INDIVIDUAL)
  currentStep    Int                   @default(1)
  completedSteps Int[]                 @default([])

  profilePhotoUrl   String?
  dob               String?
  licenseNumber     String?
  vehicleMake       String?
  vehicleModel      String?
  vehicleYear       String?
  vehiclePlate      String?
  vehicleTier       String?
  vehicleColor      String?

  bankAccountName   String?
  bankInstitution   String?
  bankAccountNumber String?
  bankRoutingNumber String?

  signature          String?
  gpsConsentAt       DateTime?
  privacyPolicyAt    DateTime?
  legalNoticeAt      DateTime?
  termsAcceptedAt    DateTime?
  contractSignedAt   DateTime?

  adminStatus        OnboardingAdminStatus @default(PENDING)
  adminNote          String?
  reviewedAt         DateTime?

  submittedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  driverId   String            @unique
  driver     Driver            @relation(fields: [driverId], references: [id])
  documents  OnboardingDocument[]

  @@index([adminStatus])
}

model OnboardingDocument {
  id           String         @id @default(cuid())
  type         DocumentType
  fileName     String
  status       DocumentStatus @default(PENDING)
  adminNote    String?
  uploadedAt   DateTime       @default(now())

  onboardingId String
  onboarding   DriverOnboarding @relation(fields: [onboardingId], references: [id])

  @@index([onboardingId])
}

// ─── Incident Reporting ───────────────────────────────────────────────────────

model IncidentReport {
  id                  String       @id @default(cuid())
  reportedByRole      String
  type                IncidentType
  description         String
  aiSummary           String?
  aiClassification    String?
  aiRiskLevel         RiskLevel?
  aiSuggestedAction   String?
  reviewStatus        ReviewStatus @default(PENDING)
  reviewNote          String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])

  @@index([reviewStatus])
  @@index([bookingId])
}

// ─── Wallet ────────────────────────────────────────────────────────────────────

model WalletTransaction {
  id        String         @id @default(cuid())
  type      WalletTxType
  status    WalletTxStatus @default(PENDING)
  amount    Float
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  driverId  String
  driver    Driver         @relation(fields: [driverId], references: [id])
}
