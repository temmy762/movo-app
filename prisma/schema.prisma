generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  DRIVER
  ADMIN
}

enum DriverStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum WalletTxType {
  PAYOUT
  TOPUP
  EARNING
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SupportCategory {
  CONTACT_DRIVER
  RIDE_ISSUE
  PAYMENT_HELP
  CHAT_SUPPORT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentType {
  ACCIDENT
  UNSAFE_DRIVING
  HARASSMENT
  VEHICLE_ISSUE
  ROUTE_DEVIATION
  OTHER
}

enum ReviewStatus {
  PENDING
  AI_REVIEWED
  MANUALLY_REVIEWED
  RESOLVED
  DISMISSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OnboardingType {
  INDIVIDUAL
  FLEET
}

enum BookingType {
  NORMAL
  AIRPORT
  HOURLY
  CARE
}

enum AssignmentType {
  PRIMARY
  RECOVERY
}

enum CareRole {
  PRIMARY
  SUPPORT
}

enum CareAssignmentStatus {
  SEARCHING
  PENDING
  ACCEPTED
  ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum OnboardingAdminStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  DRIVERS_LICENSE
  BACKGROUND_CHECK
  DRIVERS_ABSTRACT
  VEHICLE_REGISTRATION
  VEHICLE_INSURANCE
  VEHICLE_PHOTO
  PROFILE_PHOTO
  WORK_ELIGIBILITY
  BANKING_INFO
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Auth models ──────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String?   @unique
  phone       String?   @unique
  password    String
  googleId    String?   @unique
  role        Role      @default(USER)
  title       String?
  company     String?
  street      String?
  postCode    String?
  city        String?
  country     String?
  stripeCustomerId String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions        Session[]
  bookings         Booking[]
  supportTickets   SupportTicket[]
  incidentReports  IncidentReport[]
  notifications    Notification[] @relation(name: "UserNotifications")
}


model Driver {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  email     String       @unique
  phone     String?      @unique
  password  String
  country   String
  city      String
  status    DriverStatus @default(PENDING)
  lat       Float?
  lng       Float?
  isOnline           Boolean            @default(false)
  photoUrl           String?
  fleetOwnerId       String?
  fleetDriverSplit   Float              @default(0.85)
  stripeAccountId    String?
  stripeAccountStatus String?
  trainingCompleted  Int[]              @default([])
  onboardingType     OnboardingType?    
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sessions         Session[]
  bookings         Booking[]
  vehicle          Vehicle?
  walletTxs        WalletTransaction[]
  incidentReports  IncidentReport[]
  onboarding       DriverOnboarding?
  notifications    Notification[] @relation(name: "DriverNotifications")
  careAssignments  CareAssignment[]
}

model Vehicle {
  id        String   @id @default(cuid())
  driverId  String   @unique
  driver    Driver   @relation(fields: [driverId], references: [id])
  make      String
  model     String
  year      Int
  plate     String
  tier      String
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  role      Role
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id                    String        @id @default(cuid())
  clientName            String
  pickup                String
  dropoff               String
  pickupLat             Float?
  pickupLng             Float?
  dropoffLat            Float?
  dropoffLng            Float?
  carTier               String
  carName               String
  fare                  Float
  serviceFee            Float
  gst                   Float?
  additionalStopFee     Float?
  airportFee            Float?
  total                 Float
  status                BookingStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(UNPAID)
  stripePaymentIntentId String?
  rating                Float?
  review                String?
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledBy           String?
  refundId              String?
  bookingType           BookingType   @default(NORMAL)
  assignmentType        AssignmentType?
  parentBookingId       String?
  recoveryDriverId      String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  supportTickets  SupportTicket[]
  tripLocations   TripLocation[]
  incidentReports IncidentReport[]
  messages        BookingMessage[]
  careAssignments CareAssignment[]
}

// ─── Care Ride Assignments ────────────────────────────────────────────────────

model CareAssignment {
  id          String               @id @default(cuid())
  bookingId   String
  booking     Booking              @relation(fields: [bookingId], references: [id])
  driverId    String?
  driver      Driver?              @relation(fields: [driverId], references: [id])
  role        CareRole
  status      CareAssignmentStatus @default(SEARCHING)
  dispatchedAt DateTime?
  acceptedAt   DateTime?
  arrivedAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([bookingId])
  @@index([driverId])
}

// ─── Trip Location (live tracking) ────────────────────────────────────────────

model TripLocation {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  lat       Float
  lng       Float
  heading   Float?
  speed     Float?
  timestamp DateTime @default(now())

  @@index([bookingId, timestamp])
}

// ─── Booking Chat ────────────────────────────────────────────────────────────

model BookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  sender    String   // "driver" | "rider"
  senderId  String   // driverId or userId
  text      String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

// ─── Web Push Subscriptions ───────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  driverId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([driverId])
}

// ─── Support ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String          @id @default(cuid())
  category    SupportCategory
  issue       String?
  description String?
  status      SupportStatus   @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookingId   String?
  booking     Booking?        @relation(fields: [bookingId], references: [id])

  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
}

// ─── Driver Onboarding ─────────────────────────────────────────────────────────

model DriverOnboarding {
  id             String                @id @default(cuid())
  type           OnboardingType        @default(INDIVIDUAL)
  currentStep    Int                   @default(1)
  completedSteps Int[]                 @default([])

  // Individual driver fields
  profilePhotoUrl   String?
  dob               String?
  licenseNumber     String?
  vehicleMake       String?
  vehicleModel      String?
  vehicleYear       String?
  vehiclePlate      String?
  vehicleTier       String?
  vehicleColor      String?

  // Fleet partner fields
  companyName       String?
  legalForm         String?
  country           String?
  city              String?
  street            String?
  postalCode        String?
  taxId             String?
  vatId             String?
  registrationNumber String?
  fleetSize         String?
  vehicleDescriptions String?
  
  // First vehicle info (for fleet)
  firstVehicleYear  String?
  firstVehicleBrand String?
  firstVehicleModel String?
  firstVehicleClass String?
  firstVehicleColor String?
  firstVehiclePlate String?
  firstVehicleVin   String?
  
  // First chauffeur info (for fleet)
  firstChauffeurFirstName String?
  firstChauffeurLastName  String?
  firstChauffeurEmail     String?
  firstChauffeurPhone     String?

  bankAccountName   String?
  bankInstitution   String?
  bankAccountNumber String?
  bankRoutingNumber String?

  signature          String?
  gpsConsentAt       DateTime?
  privacyPolicyAt    DateTime?
  legalNoticeAt      DateTime?
  termsAcceptedAt    DateTime?
  contractSignedAt   DateTime?

  adminStatus        OnboardingAdminStatus @default(PENDING)
  adminNote          String?
  reviewedAt         DateTime?
  reviewedBy         String?

  submittedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  driverId   String            @unique
  driver     Driver            @relation(fields: [driverId], references: [id])
  documents  OnboardingDocument[]

  @@index([adminStatus])
}

model OnboardingDocument {
  id           String         @id @default(cuid())
  type         DocumentType
  fileName     String
  fileUrl      String?
  status       DocumentStatus @default(PENDING)
  adminNote    String?
  uploadedAt   DateTime       @default(now())

  onboardingId String
  onboarding   DriverOnboarding @relation(fields: [onboardingId], references: [id])

  @@index([onboardingId])
}

// ─── Incident Reporting ───────────────────────────────────────────────────────

model IncidentReport {
  id                  String       @id @default(cuid())
  reportedByRole      String
  type                IncidentType
  description         String
  aiSummary           String?
  aiClassification    String?
  aiRiskLevel         RiskLevel?
  aiSuggestedAction   String?
  reviewStatus        ReviewStatus @default(PENDING)
  reviewNote          String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])

  @@index([reviewStatus])
  @@index([bookingId])
}

// ─── Wallet ────────────────────────────────────────────────────────────────────

model WalletTransaction {
  id        String         @id @default(cuid())
  type      WalletTxType
  status    WalletTxStatus @default(PENDING)
  amount    Float
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  driverId  String
  driver    Driver         @relation(fields: [driverId], references: [id])
}

// ─── Notification System ──────────────────────────────────────────────────────

enum NotificationType {
  EMAIL
  IN_APP
  SMS
  PUSH
}

enum NotificationChannel {
  RIDER
  CHAUFFEUR
  ADMIN
  SYSTEM
}

enum NotificationEventType {
  // Rider events
  RIDER_WELCOME
  RIDER_EMAIL_VERIFICATION
  RIDER_PASSWORD_RESET
  RIDER_BOOKING_CONFIRMED
  RIDER_BOOKING_UPDATED
  RIDER_DRIVER_ASSIGNED
  RIDER_RIDE_COMPLETED
  RIDER_PAYMENT_RECEIPT
  RIDER_INCIDENT_SUBMITTED
  RIDER_INCIDENT_RESOLVED

  // Chauffeur events
  CHAUFFEUR_WELCOME
  CHAUFFEUR_ONBOARDING_SUBMITTED
  CHAUFFEUR_ONBOARDING_APPROVED
  CHAUFFEUR_ONBOARDING_REJECTED
  CHAUFFEUR_BOOKING_ASSIGNED
  CHAUFFEUR_BOOKING_CANCELLED
  CHAUFFEUR_PAYOUT_NOTIFICATION

  // Admin events
  ADMIN_NEW_DRIVER_APPLICATION
  ADMIN_NEW_INCIDENT_REPORT
  ADMIN_EMERGENCY_INCIDENT
  ADMIN_NEW_FLEET_APPLICATION
  ADMIN_PAYOUT_REQUEST

  // Support events
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_UPDATED
  SUPPORT_TICKET_RESOLVED
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

model Notification {
  id        String                @id @default(cuid())

  // Polymorphic recipient (one of these will be set)
  userId    String?
  user      User?                 @relation(fields: [userId], references: [id], name: "UserNotifications")

  driverId  String?
  driver    Driver?               @relation(fields: [driverId], references: [id], name: "DriverNotifications")

  // Admin recipients (for admin notifications, we store which admins were notified)
  adminNotifications AdminNotification[]

  // Notification metadata
  type      NotificationType
  channel   NotificationChannel
  eventType NotificationEventType

  // Content
  title     String
  message   String                @db.Text
  data      Json?                 // Flexible data payload (bookingId, incidentId, etc.)

  // Email specific
  emailSubject   String?
  emailTemplate  String?          // Template name used
  emailSentAt    DateTime?
  emailError     String?

  // In-app specific
  readAt    DateTime?
  clickedAt DateTime?

  // Status tracking
  status    NotificationStatus    @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  // Related entities (for context)
  bookingId     String?
  incidentId    String?
  onboardingId  String?
  ticketId      String?

  @@index([userId, status, createdAt])
  @@index([driverId, status, createdAt])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
  @@index([bookingId])
  @@index([incidentId])
}

// Track which admins have been notified (for admin broadcast notifications)
model AdminNotification {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  adminEmail     String       // Store email since admin might not have user record
  adminUserId    String?      // Optional link if admin has user account

  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
  @@index([adminEmail, readAt])
}

// ─── Authentication Tokens ────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  phone     String?
  otp       String?

  @@index([email, expiresAt])
  @@index([token])
  @@index([phone, expiresAt])
}

model AdminOTP {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
  @@index([otp])
}

model AdminResetToken {
  id        String   @id @default(cuid())
  phone     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
  @@index([token])
}

model VehicleTierConfig {
  id             String   @id @default(cuid())
  tier           String   @unique
  name           String
  image          String
  price          Int      @default(0)   // legacy — kept for compat
  baseFare       Float    @default(4.00)
  ratePerKm      Float    @default(1.25)
  ratePerMin     Float    @default(0.25)
  minFare        Float    @default(18.00)
  hourlyRate     Float    @default(55.00)
  hourlyMinHours Int      @default(2)
  commissionRate Float    @default(0.20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PricingConfig {
  id                  String   @id @default(cuid())
  gstRate             Float    @default(0.05)
  serviceFeeRate      Float    @default(0.12)
  additionalStopFee   Float    @default(5.00)
  airportPickupFee    Float    @default(10.00)
  freeWaitingMinutes  Int      @default(5)
  waitingRatePerMin   Float    @default(0.75)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
